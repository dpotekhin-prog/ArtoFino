{
    "swagger": "2.0",
    "info": {
        "description": "Backend service for ArtoFino platform.",
        "title": "ArtoFino Backend API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:9000",
    "basePath": "/",
    "paths": {
        "/admin/ping": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Admin ping",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.AdminPingResponse"
                        }
                    }
                }
            }
        },
        "/admin/stats": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Admin stats",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.AdminStatsResponse"
                        }
                    }
                }
            }
        },
        "/authors/apply": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Allows a registered user to submit portfolio and social links to get vetted and upgraded to the 'artist' role.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "authors"
                ],
                "summary": "Apply for Artist (Creator) status",
                "parameters": [
                    {
                        "description": "Artist application data",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreatorApplicationInput"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/handlers.CreatorApplicationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/hc": {
            "get": {
                "description": "Returns OK if service is alive",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/lc": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "ALIVE",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/objects/{id}": {
            "get": {
                "description": "Returns art object data with current price calculated based on daily linear growth, custom currency and dynamic rate",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "objects"
                ],
                "summary": "Get art object with dynamic price",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Object ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.ArtObjectResponse"
                        }
                    }
                }
            }
        },
        "/rc": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "READY",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "NOT READY",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/transactions/buy": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Purchase between 1% and 10% of an art object. Price is locked at the current calculated rate using the linear growth formula.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Buy a share in an art object",
                "parameters": [
                    {
                        "description": "Purchase data",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.BuyShareInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.TransactionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/transfers/request": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Allows a Partner to apply for hosting an art object at their event/location.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transfers"
                ],
                "summary": "Request art object for temporary use",
                "parameters": [
                    {
                        "description": "Transfer request details",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.TransferRequestInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.TransferRequestResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/users/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get current user profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.UserProfileResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.AdminPingResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "admin pong"
                }
            }
        },
        "handlers.AdminStatsResponse": {
            "type": "object",
            "properties": {
                "activeOrders": {
                    "type": "integer",
                    "example": 12
                },
                "totalRevenue": {
                    "type": "number",
                    "example": 1450.5
                },
                "totalUsers": {
                    "type": "integer",
                    "example": 154
                }
            }
        },
        "handlers.ArtObjectResponse": {
            "type": "object",
            "properties": {
                "artistId": {
                    "type": "string",
                    "example": "artist-4321"
                },
                "basePrice": {
                    "type": "number",
                    "example": 5000
                },
                "country": {
                    "type": "string",
                    "example": "CZ"
                },
                "createdAt": {
                    "type": "string"
                },
                "currency": {
                    "type": "string",
                    "example": "EUR"
                },
                "currentHolderId": {
                    "type": "string",
                    "example": "partner-9876"
                },
                "currentPrice": {
                    "type": "number",
                    "example": 5075.5
                },
                "dailyGrowthRate": {
                    "type": "number",
                    "example": 0.0001
                },
                "id": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5"
                },
                "title": {
                    "type": "string",
                    "example": "Sunset over Prague"
                }
            }
        },
        "handlers.BuyShareInput": {
            "type": "object",
            "required": [
                "objectId",
                "sharePct"
            ],
            "properties": {
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5"
                },
                "sharePct": {
                    "type": "number",
                    "maximum": 10,
                    "minimum": 1,
                    "example": 5
                }
            }
        },
        "handlers.CreatorApplicationInput": {
            "type": "object",
            "required": [
                "bio",
                "portfolioUrl",
                "socialLinks"
            ],
            "properties": {
                "bio": {
                    "type": "string",
                    "maxLength": 500,
                    "example": "Contemporary oil painter based in Prague, focusing on urban landscapes."
                },
                "portfolioUrl": {
                    "type": "string",
                    "example": "https://behance.net/my-art-portfolio"
                },
                "socialLinks": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "['https://instagram.com/artist_handle']"
                    ]
                }
            }
        },
        "handlers.CreatorApplicationResponse": {
            "type": "object",
            "properties": {
                "applicationId": {
                    "type": "string",
                    "example": "app-111222"
                },
                "bio": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "portfolioUrl": {
                    "type": "string"
                },
                "status": {
                    "description": "pending, approved, rejected",
                    "type": "string",
                    "example": "pending"
                },
                "userId": {
                    "type": "string",
                    "example": "user-keycloak-uuid"
                }
            }
        },
        "handlers.TransactionResponse": {
            "type": "object",
            "properties": {
                "amountPaid": {
                    "type": "number",
                    "example": 253.75
                },
                "buyerId": {
                    "type": "string",
                    "example": "user-buyer-uuid"
                },
                "createdAt": {
                    "type": "string"
                },
                "currency": {
                    "type": "string",
                    "example": "EUR"
                },
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5"
                },
                "sellerId": {
                    "type": "string",
                    "example": "artist-seller-uuid"
                },
                "sharePct": {
                    "type": "number",
                    "example": 5
                },
                "transactionId": {
                    "type": "string",
                    "example": "tx-abc-999888"
                }
            }
        },
        "handlers.TransferRequestInput": {
            "type": "object",
            "required": [
                "durationDays",
                "eventDetails",
                "objectId"
            ],
            "properties": {
                "durationDays": {
                    "type": "integer",
                    "minimum": 1,
                    "example": 7
                },
                "eventDetails": {
                    "type": "string",
                    "example": "Corporate pop-up exhibition or apartment art party"
                },
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5"
                }
            }
        },
        "handlers.TransferRequestResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "eventDetails": {
                    "type": "string",
                    "example": "Corporate pop-up exhibition or apartment art party"
                },
                "expiresAt": {
                    "type": "string"
                },
                "fromHolderId": {
                    "type": "string",
                    "example": "partner-current-owner-uuid"
                },
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5"
                },
                "requesterId": {
                    "type": "string",
                    "example": "partner-host-uuid"
                },
                "status": {
                    "description": "pending, approved, rejected, completed",
                    "type": "string",
                    "example": "pending"
                },
                "transferId": {
                    "type": "string",
                    "example": "tr-999111"
                }
            }
        },
        "handlers.UserProfileResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@artofino.com"
                },
                "firstName": {
                    "type": "string",
                    "example": "John"
                },
                "id": {
                    "type": "string",
                    "example": "4321-abcd-1234"
                },
                "lastName": {
                    "type": "string",
                    "example": "Doe"
                },
                "username": {
                    "type": "string",
                    "example": "johndoe"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Enter \"Bearer \u003ctoken\u003e\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}