{
    "swagger": "2.0",
    "info": {
        "description": "Backend service for ArtoFino platform.",
        "title": "ArtoFino Backend API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:9000",
    "basePath": "/",
    "paths": {
        "/admin/objects": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Allows administrators to mint a new digital art object metadata entry inside MongoDB with base pricing configuration.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Create a new art object asset",
                "parameters": [
                    {
                        "description": "Art Object configuration state",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreateObjectInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/mongo.Object"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/authors/apply": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Allows a registered user to submit portfolio and social links to get vetted and upgraded to the 'artist' role.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "authors"
                ],
                "summary": "Apply for Artist (Creator) status",
                "parameters": [
                    {
                        "description": "Artist application data",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreatorApplicationInput"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/handlers.CreatorApplicationResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/hc": {
            "get": {
                "description": "Returns OK if service is alive",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/lc": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "ALIVE",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/rc": {
            "get": {
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Readiness check",
                "responses": {
                    "200": {
                        "description": "READY",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "NOT READY",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/transactions/buy": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Purchase a fractional percentage of an art object. Price is locked and calculated dynamically using the live growth formula from MongoDB.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Buy a share in an art object",
                "parameters": [
                    {
                        "description": "Purchase percentage details",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.BuyShareInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.TransactionResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/transfers/request": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Allows a Partner to apply for hosting an art object at their event/location.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transfers"
                ],
                "summary": "Request art object for temporary use",
                "parameters": [
                    {
                        "description": "Transfer request details",
                        "name": "input",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.TransferRequestInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handlers.TransferRequestResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/transfers/{id}/approve": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Allows the current holder or owner of the art object to approve a pending temporary transfer request.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transfers"
                ],
                "summary": "Approve a physical transfer request",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Transfer ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.TransferApprovalResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/users/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get current user profile",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.UserProfileResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.BuyShareInput": {
            "type": "object",
            "required": [
                "objectId",
                "sharePct"
            ],
            "properties": {
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5777777"
                },
                "sharePct": {
                    "type": "number",
                    "maximum": 10,
                    "minimum": 1,
                    "example": 5
                }
            }
        },
        "handlers.CreateObjectInput": {
            "type": "object",
            "required": [
                "artistId",
                "basePrice",
                "currency",
                "dailyGrowthRate",
                "title"
            ],
            "properties": {
                "artistId": {
                    "type": "string",
                    "example": "artist-uuid-111"
                },
                "basePrice": {
                    "type": "number",
                    "example": 5000
                },
                "currency": {
                    "type": "string",
                    "example": "EUR"
                },
                "dailyGrowthRate": {
                    "type": "number",
                    "example": 0.00025
                },
                "description": {
                    "type": "string",
                    "example": "An incredible modern oil canvas exploration."
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "['oil'",
                        " 'canvas'",
                        " 'modern']"
                    ]
                },
                "title": {
                    "type": "string",
                    "example": "Symphony of Lights"
                }
            }
        },
        "handlers.CreatorApplicationInput": {
            "type": "object",
            "required": [
                "bio",
                "portfolioUrl",
                "socialLinks"
            ],
            "properties": {
                "bio": {
                    "type": "string",
                    "maxLength": 500,
                    "example": "Contemporary oil painter based in Prague, focusing on urban landscapes."
                },
                "portfolioUrl": {
                    "type": "string",
                    "example": "https://behance.net/my-art-portfolio"
                },
                "socialLinks": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "['https://instagram.com/artist_handle']"
                    ]
                }
            }
        },
        "handlers.CreatorApplicationResponse": {
            "type": "object",
            "properties": {
                "applicationId": {
                    "type": "string",
                    "example": "app-111222"
                },
                "bio": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "portfolioUrl": {
                    "type": "string"
                },
                "status": {
                    "description": "pending, approved, rejected",
                    "type": "string",
                    "example": "pending"
                },
                "userId": {
                    "type": "string",
                    "example": "user-keycloak-uuid"
                }
            }
        },
        "handlers.TransactionResponse": {
            "type": "object",
            "properties": {
                "amountPaid": {
                    "type": "number",
                    "example": 253.75
                },
                "buyerId": {
                    "type": "string",
                    "example": "user-buyer-uuid"
                },
                "createdAt": {
                    "type": "string"
                },
                "currency": {
                    "type": "string",
                    "example": "EUR"
                },
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5777777"
                },
                "sellerId": {
                    "type": "string",
                    "example": "artist-seller-uuid"
                },
                "sharePct": {
                    "type": "number",
                    "example": 5
                },
                "transactionId": {
                    "type": "string",
                    "example": "uuid-string-here"
                }
            }
        },
        "handlers.TransferApprovalResponse": {
            "type": "object",
            "properties": {
                "approvedAt": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "approved"
                },
                "transferId": {
                    "type": "string",
                    "example": "tr-888999"
                }
            }
        },
        "handlers.TransferRequestInput": {
            "type": "object",
            "required": [
                "destination",
                "objectId"
            ],
            "properties": {
                "destination": {
                    "type": "string",
                    "example": "Prague National Gallery, Hall 4"
                },
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5777777"
                }
            }
        },
        "handlers.TransferRequestResponse": {
            "type": "object",
            "properties": {
                "createdAt": {
                    "type": "string"
                },
                "destination": {
                    "type": "string",
                    "example": "Prague National Gallery, Hall 4"
                },
                "objectId": {
                    "type": "string",
                    "example": "64a7b3e1f1d2c3a4b5777777"
                },
                "requesterId": {
                    "type": "string",
                    "example": "partner-host-uuid"
                },
                "status": {
                    "type": "string",
                    "example": "pending"
                },
                "transferId": {
                    "type": "string",
                    "example": "uuid-string"
                }
            }
        },
        "handlers.UserProfileResponse": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "user@artofino.com"
                },
                "firstName": {
                    "type": "string",
                    "example": "John"
                },
                "id": {
                    "type": "string",
                    "example": "4321-abcd-1234"
                },
                "lastName": {
                    "type": "string",
                    "example": "Doe"
                },
                "username": {
                    "type": "string",
                    "example": "johndoe"
                }
            }
        },
        "mongo.Object": {
            "type": "object",
            "properties": {
                "basePrice": {
                    "type": "number"
                },
                "createdAt": {
                    "type": "string"
                },
                "currency": {
                    "type": "string"
                },
                "currentHolderId": {
                    "type": "string"
                },
                "dailyGrowthRate": {
                    "type": "number"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "ownerUserId": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "title": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Enter \"Bearer \u003ctoken\u003e\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}